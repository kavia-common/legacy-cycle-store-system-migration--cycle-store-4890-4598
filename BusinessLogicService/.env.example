# Server config
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT verification secret (used to validate bearer tokens from API Gateway)
# For production rotate keys regularly. Either set JWT_SECRET or configure JWKS.
JWT_SECRET=changeme-super-secret

# Service-to-service static bearer token used when calling DataService and NotificationService
# Ensure this token is stored securely and rotated regularly.
SERVICE_AUTH_TOKEN=changeme-service-token

# Upstream service URLs (base URLs should include the path portion up to API version)
# Example: http://localhost:4001/api/v1 (DataService)
# Example: http://localhost:4002/api/v1 (NotificationService)
DATA_SERVICE_URL=http://localhost:4001/api/v1
NOTIFICATION_SERVICE_URL=http://localhost:4002/api/v1

# Idempotency settings
# TTL for cached Idempotency-Key values in seconds
IDEMPOTENCY_TTL_SECONDS=600
